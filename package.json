{
  "name": "gpu-font",
  "version": "0.1.0",
  "description": "Find the font in an image of text: ranks 2,000+ free font families by look, on the user's device with WebGPU",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/match.d.ts",
      "default": "./src/match.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/match.mjs",
  "types": "./src/match.d.ts",
  "files": [
    "src/match.mjs",
    "src/match.d.ts",
    "src/catalog.mjs",
    "src/input.mjs",
    "src/line.mjs",
    "src/network.mjs",
    "src/network-gpu.mjs",
    "src/prepare.mjs",
    "models/encoder/encoder.json",
    "models/encoder/google-fonts.json",
    "models/encoder/catalogs/*.json"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test && node scripts/python.mjs -m unittest discover -s tests -p 'test_*.py'",
    "prepublishOnly": "node --test",
    "data:import": "node scripts/python.mjs scripts/fixtures.py import",
    "data:render": "node scripts/python.mjs scripts/fixtures.py render",
    "data:browser": "node scripts/browser.mjs",
    "data:prepare": "node scripts/prepare.mjs",
    "data:preview": "node scripts/python.mjs scripts/fixtures.py preview",
    "baseline": "node scripts/baseline.mjs",
    "train": "node scripts/python.mjs train/train.py",
    "train:robustness": "node scripts/robustness.mjs",
    "train:focus": "node scripts/focus.mjs",
    "train:ten": "node scripts/ten.mjs",
    "demo:build": "node scripts/demo-build.mjs",
    "stamp": "node scripts/stamp.mjs",
    "demo": "node scripts/demo-serve.mjs",
    "test:demo": "node checks/demo.mjs",
    "train:hundred": "node scripts/hundred.mjs"
  },
  "keywords": [
    "font",
    "font-matching",
    "font-identification",
    "font-recognition",
    "identify-font",
    "font-finder",
    "whatthefont",
    "typography",
    "google-fonts",
    "webgpu",
    "neural-network",
    "image"
  ],
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "license": "MIT",
  "homepage": "https://dy.github.io/gpu-font/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dy/gpu-font.git"
  },
  "bugs": {
    "url": "https://github.com/dy/gpu-font/issues"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
