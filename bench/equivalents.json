{
 "version": 1,
 "scope": "Open fonts documented to reproduce, revive or stand in for a classic typeface. A row names the classic as the canon names it, the open family as its files name it, the relation, and one page that states the relation. Only same-design, clone, revival and basis count as coverage of the classic's look.",
 "relations": {
  "same-design": "The same design under another name, edition or distribution.",
  "clone": "Drawn to reproduce the classic's letterforms closely, including extended derivatives of such a clone.",
  "revival": "A new digitisation of the same historical design, drawn from original specimens.",
  "metric-compatible": "Same advance widths so documents keep their layout; the letterforms differ. Not coverage of the look.",
  "inspired": "Documented as inspired by the classic; not a reproduction. Not coverage of the look.",
  "basis": "The classic was itself derived from this open font and keeps most of its letterforms."
 },
